    }
  ],
  "edges": [
    {
      "id": "e_do_check",
      "from": "do",
      "to": "check",
      "label": "потоки закрыты",
      "role": "main"
    },
    {
      "id": "e_sec_audit",
      "from": "check",
      "to": "sec_audit",
      "label": "условно · fork auth/секреты/ввод",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e_sec_report",
      "from": "sec_audit",
      "to": "check",
      "label": "отчёт → CHECK · агрегация",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "e_lenses",
      "from": "check",
      "to": "act",
      "label": "все 4 потока + security отчёт зелёные · final CHECK",
      "role": "main"
    },
    {
      "id": "e_go",
      "from": "plan",
      "to": "do",
      "label": "`go` · n=1 / авто: сразу",
      "role": "main"
    },
    {
      "id": "e_check_orb",
      "from": "check",
      "to": "orb",
      "label": "вердикт pass/fail (все потоки + security)",
      "role": "return"
    },
    {
      "id": "e_escalate_orb",
      "from": "escalate",
      "to": "orb",
      "label": "решение (для маршрутизации)",
      "variant": "security",
      "role": "return"
    },
    {
      "id": "e_orb_do",
      "from": "orb",
      "to": "do",
      "label": "решение: r не исчерпан → DO / дефект CHECK",
      "variant": "security",
      "role": "return"
    },
    {
      "id": "e_orb_stop",
      "from": "orb",
      "to": "stop",
      "label": "нет actionable PLAN r+1"
    },
    {
      "id": "e_orb_escalate",
      "from": "orb",
      "to": "escalate",
      "label": "повтор после 1 фикса · 3-й провал CHECK(r) · жёсткий security tradeoff",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e_orb_replan",
      "from": "orb",
      "to": "plan",
      "label": "решение: исчерпан r → genuine PLAN r+1",
      "variant": "security",
      "role": "return"
    },
    {
      "id": "e_do_replan",
      "from": "do",
      "to": "plan",
      "label": "новое предусловие / блокер",
      "variant": "security",
      "role": "return"
    }
  ]
}