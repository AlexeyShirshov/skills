{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "pdca-dotnet: оркестратор и фазы цикла",
    "output": "pdca-dotnet.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-cycle",
        "label": "Цикл",
        "focus": [
          "plan",
          "do",
          "check",
          "act"
        ],
        "note": "PLAN → DO → CHECK → ACT по гейтам; ACT только после зелёного CHECK; go — начало DO."
      },
      {
        "id": "branches",
        "label": "Оркестратор и ветки",
        "focus": [
          "orb",
          "check",
          "sec_audit",
          "escalate",
          "stop"
        ],
        "note": "Cheap-оркестратор маршрутизирует решение escalate: r не исчерпан → DO, исчерпан → PLAN r+1, иначе STOP; security — поток CHECK."
      }
    ],
    "legend": {
      "entries": {
        "backend": {
          "label": "дешёвая ступень (cheap)"
        },
        "security": {
          "label": "средняя ступень (medium)"
        },
        "external": {
          "label": "дорогая ступень (strong)"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "l_plan",
      "label": "PLAN"
    },
    {
      "id": "l_do",
      "label": "DO"
    },
    {
      "id": "l_check",
      "label": "CHECK"
    },
    {
      "id": "l_act",
      "label": "ACT / EXIT"
    },
    {
      "id": "l_ret",
      "label": "Оркестратор и ветки",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "plan",
    "do",
    "check",
    "act"
  ],
  "nodes": [
