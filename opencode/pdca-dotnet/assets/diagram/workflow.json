      "width": 150
    },
    {
      "id": "do",
      "lane": "l_do",
      "col": 0,
      "type": "backend",
      "label": "DO",
      "sublabel": "код ∥ тесты ∥ доки",
      "width": 150
    },
    {
      "id": "check",
      "lane": "l_check",
      "col": 0,
      "type": "security",
      "label": "CHECK",
      "sublabel": "вердикт · аудит + линзы",
      "width": 150
    },
    {
      "id": "sec_audit",
      "lane": "l_check",
      "col": 1,
      "type": "security",
      "label": "CHECK · security",
      "sublabel": "поток CHECK · отчёт",
      "width": 132
    },
    {
      "id": "act",
      "lane": "l_act",
      "col": 0,
      "type": "backend",
      "label": "ACT",
