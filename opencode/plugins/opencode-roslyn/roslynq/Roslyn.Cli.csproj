<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>roslynq</AssemblyName>
    <RootNamespace>RoslynQ</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>roslynq</ToolCommandName>
    <PackageId>opencode-roslyn</PackageId>
    <Version>1.0.0</Version>
    <Authors>Alexey Shirshov</Authors>
    <Description>Roslyn semantic analysis CLI for opencode: structure, symbols, members, refs, callers, implementations, rename.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AlexeyShirshov/skills/tree/main/opencode/plugins/opencode-roslyn</PackageProjectUrl>
    <PackageTags>opencode;plugin;roslyn;csharp;dotnet;symbols;refactoring</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
