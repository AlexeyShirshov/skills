{
  "note": "Toy adapted traces for the test-only auditor. The premise flags (relationship_supported, scope) are human-review labels, not physical truth; the model is not executed.",
  "cases": [
    {
      "id": "manual-plan-then-checker-dispatch",
      "mode": "autonomous",
      "plan": {"revision": 1, "verification": "manual", "scope": ["answer"], "approval_ref": "A1"},
      "events": [
        {"type": "dispatch", "verification": "manual", "scope": ["answer"]},
        {"type": "dispatch", "verification": "checker", "scope": ["answer"]}
      ],
      "expected": {"outcome": "plan_return", "violations": ["unauthorized_plan_drift"]}
    },
    {
      "id": "checker-authorized-by-plan-revision",
      "mode": "autonomous",
      "plan": {"revision": 1, "verification": "manual", "scope": ["answer"], "approval_ref": "A1"},
      "events": [
        {"type": "plan_revision", "revision": 2, "verification": "checker", "scope": ["answer"], "approval_ref": "A2"},
        {"type": "dispatch", "verification": "checker", "scope": ["answer"]}
      ],
      "expected": {"outcome": "continue", "violations": []}
    },
    {
      "id": "refuted-assumption-rewrite-unchanged",
      "mode": "autonomous",
      "plan": {"revision": 1, "verification": "manual", "scope": ["answer"], "approval_ref": "A1"},
      "events": [
        {"type": "observation", "refutes": "assumed stroke", "evidence": "M1"},
        {"type": "rewrite", "plan_revision": 1}
      ],
      "expected": {"outcome": "plan_return", "violations": ["missing_return_before_rewrite"]}
    },
    {
      "id": "refuted-assumption-returned-before-rewrite",
      "mode": "autonomous",
      "plan": {"revision": 1, "verification": "manual", "scope": ["answer"], "approval_ref": "A1"},
      "events": [
        {"type": "observation", "refutes": "assumed stroke", "evidence": "M1"},
        {"type": "plan_revision", "revision": 2, "verification": "manual", "scope": ["answer"], "approval_ref": "A2"},
        {"type": "rewrite", "plan_revision": 2}
      ],
      "expected": {"outcome": "continue", "violations": []}
    },
    {
      "id": "class-ceiling-generalised-to-goal",
      "mode": "autonomous",
